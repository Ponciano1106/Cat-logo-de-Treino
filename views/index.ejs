<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <main class="container">
    <header class="page-header">
      <div>
        <span class="badge-top">Express + EJS + MySQL</span>
        <h1>Controle de Treinos</h1>
        <p class="subtitle">Pesquise exercícios prontos, implemente no treino, ordene, edite ou remova.</p>
      </div>
      <div class="stats">
        <div class="stat-card">
          <span class="stat-label">Exercícios</span>
          <strong class="stat-value"><%= itens.length %></strong>
        </div>
        <div class="stat-card">
          <span class="stat-label">Total de séries</span>
          <strong class="stat-value">
            <%= itens.reduce((acc, item) => acc + Number(item.series || 0), 0) %>
          </strong>
        </div>
      </div>
    </header>

    <section class="card catalog-section">
      <div class="section-head">
        <div>
          <h2>Catálogo de exercícios</h2>
          <p class="hint">Pesquise um exercício e clique em <strong>Implementar</strong> para preencher o formulário.</p>
        </div>
        <input
          id="buscaCatalogo"
          type="search"
          class="search-input"
          placeholder="Pesquisar exercício ou grupo (ex.: peito, remada...)"
        >
      </div>
      <div id="catalogoGrid" class="catalog-grid"></div>
    </section>

    <section id="formCadastroSecao" class="card form-section">
      <h2>Adicionar ao treino</h2>
      <form id="formCadastro" action="/itens" method="POST" class="form-treino">
        <div class="field">
          <label for="exercicio">Exercício</label>
          <input id="exercicio" type="text" name="exercicio" placeholder="Ex.: Supino inclinado" required>
        </div>

        <div class="field">
          <label for="grupo_muscular">Grupo muscular</label>
          <input id="grupo_muscular" type="text" name="grupo_muscular" placeholder="Ex.: Peito" required>
        </div>

        <div class="field">
          <label for="series">Séries</label>
          <input id="series" type="number" name="series" placeholder="Ex.: 4" min="1" required>
        </div>

        <div class="field">
          <label for="carga_kg">Carga (kg)</label>
          <input id="carga_kg" type="number" step="0.5" name="carga_kg" placeholder="Ex.: 60" min="0" required>
        </div>

        <div class="field field-action">
          <button type="submit" class="btn-primary">Cadastrar</button>
        </div>
      </form>
    </section>

    <section class="card table-section">
      <div class="section-head">
        <h2>Exercícios do treino</h2>
        <form id="formOrdenacao" action="/itens" method="GET" class="sort-bar" data-sort="<%= sort %>" data-dir="<%= dir %>">
          <label for="sortSelect">Ordenar por:</label>
          <select id="sortSelect" name="sort">
            <option value="id">ID</option>
            <option value="exercicio">Exercício</option>
            <option value="grupo_muscular">Grupo muscular</option>
            <option value="series">Séries</option>
            <option value="carga_kg">Carga (kg)</option>
          </select>

          <select id="dirSelect" name="dir" aria-label="Direção da ordenação">
            <option value="asc">Crescente</option>
            <option value="desc">Decrescente</option>
          </select>

          <button type="submit" class="btn-secondary">Ordenar</button>
        </form>
      </div>

      <% if (itens.length === 0) { %>
        <p class="empty-state">Nenhum exercício cadastrado ainda. Escolha no catálogo acima ou preencha o formulário.</p>
      <% } else { %>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th><button type="button" class="sort-col-btn" data-col="id">ID</button></th>
                <th><button type="button" class="sort-col-btn" data-col="exercicio">Exercício</button></th>
                <th><button type="button" class="sort-col-btn" data-col="grupo_muscular">Grupo muscular</button></th>
                <th><button type="button" class="sort-col-btn" data-col="series">Séries</button></th>
                <th><button type="button" class="sort-col-btn" data-col="carga_kg">Carga (kg)</button></th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% itens.forEach((item) => { %>
                <tr class="item-row">
                  <td class="col-id">#<%= item.id %></td>
                  <td class="col-exercicio"><%= item.exercicio %></td>
                  <td><span class="tag"><%= item.grupo_muscular %></span></td>
                  <td class="col-series"><%= item.series %></td>
                  <td class="col-carga" data-carga="<%= Number(item.carga_kg) %>"><%= Number(item.carga_kg).toFixed(2) %> kg</td>
                  <td class="actions-cell">
                    <button type="button" class="btn-edit" data-id="<%= item.id %>">Editar</button>
                    <form action="/itens/<%= item.id %>/excluir" method="POST" class="inline-form">
                      <button type="submit" class="btn-delete">Excluir</button>
                    </form>
                  </td>
                </tr>

                <tr class="edit-row hidden" data-edit-id="<%= item.id %>">
                  <td colspan="6">
                    <form action="/itens/<%= item.id %>/editar" method="POST" class="edit-form">
                      <input type="text" name="exercicio" required>
                      <input type="text" name="grupo_muscular" required>
                      <input type="number" name="series" min="1" required>
                      <input type="number" step="0.5" name="carga_kg" min="0" required>
                      <button type="submit" class="btn-save">Salvar</button>
                      <button type="button" class="btn-cancel">Cancelar</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <script src="/javascripts/catalogo.js"></script>
</body>
</html>
